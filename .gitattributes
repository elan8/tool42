# Set default behavior to automatically normalize line endings
# With autocrlf=true, Git will convert LF to CRLF on checkout and CRLF to LF on commit
* text=auto

# Explicitly declare text files that should be normalized
# These will be stored as LF in the repo, but autocrlf will handle conversion on Windows
*.rs text
*.toml text
*.json text
*.md text
*.yml text
*.yaml text
*.txt text
*.sh text
*.lock text

# PowerShell scripts should use CRLF (Windows line endings)
*.ps1 text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

